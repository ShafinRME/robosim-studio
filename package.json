{
  "name": "robosim-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source, browser-based robotics lab.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "manual": "node scripts/build-manual.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @robosim/web test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "marked": "18.1.3",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
